{
  "name": "bstudio",
  "version": "1.0.0",
  "description": "Bstudio - AI-Native Autonomous Diagnostic Browser & IDE for Full-Stack Developers",
  "main": "dist/main/index.js",
  "author": "Bstudio Team",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist release tsconfig.node.tsbuildinfo",
    "compile:main": "tsc --build tsconfig.node.json --force",
    "compile:renderer": "vite build",
    "build": "npm run clean && npm run compile:renderer && npm run compile:main",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "dev:renderer": "vite",
    "dev:main": "tsc --build tsconfig.node.json --watch",
    "dev:electron": "node scripts/start-electron.js",
    "dev": "npm run compile:main && cross-env NODE_ENV=development concurrently -k -n renderer,main,electron \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "package:dir": "npm run build && electron-builder --dir",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "dotenv": "^16.4.5",
    "lucide-vue-next": "^0.441.0",
    "monaco-editor": "^0.51.0",
    "openai": "^4.56.0",
    "pinia": "^2.2.2",
    "source-map-js": "^1.2.0",
    "vue": "^3.4.38"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/node": "^20.14.14",
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  }
}
